{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "outDir": "../dist/electron",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["*.ts"]
}
