{
  "name": "openagora-desktop",
  "productName": "OpenAgora",
  "version": "0.3.0",
  "description": "An open-source app store for your desktop",
  "license": "MIT",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "preview": "vite",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "app.openagora.desktop",
    "productName": "OpenAgora",
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "binaries": [
        "Resources/bin/openagora"
      ],
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "OpenAgora contributors"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "sanjaykatta1",
        "repo": "openagora"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "44.5.1",
    "electron-builder": "26.0.12",
    "playwright-core": "1.55.0",
    "typescript": "5.8.3",
    "vite": "7.1.5"
  },
  "author": "OpenAgora contributors",
  "homepage": "https://github.com/sanjaykatta1/openagora",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanjaykatta1/openagora.git"
  }
}
